# ==============================================================================
# Dulce Mayor Server — Environment Variables Example (PostgreSQL + DonWeb VPS)
# Copy to server/.env or root .env (never commit real credentials to Git)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=dulcemayor
DB_USER=dulcemayor
DB_PASSWORD=change_me_strong_password
DB_EXTERNAL_PORT=5432

# Local development URL (Docker Compose overrides this automatically to jdbc:postgresql://postgres:5432/dulcemayor)
DB_URL=jdbc:postgresql://localhost:5432/dulcemayor
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ------------------------------------------------------------------------------
# 2. Public URLs & CORS (Replace with your DonWeb VPS IP or Domain in Production)
# Example with domain + HTTPS:
#   APP_BASE_URL=https://api.tudominio.com.ar
#   APP_FRONTEND_URL=https://tudominio.com.ar
#   APP_CENTRAL_URL=https://admin.tudominio.com.ar
#   APP_ORDER_URL=https://preventa.tudominio.com.ar
# Example with DonWeb VPS Public IP:
#   APP_BASE_URL=http://200.58.XXX.XXX:8080
#   APP_FRONTEND_URL=http://200.58.XXX.XXX:8081
#   APP_CENTRAL_URL=http://200.58.XXX.XXX:5173
#   APP_ORDER_URL=http://200.58.XXX.XXX:5174
# ------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8081
APP_CENTRAL_URL=http://localhost:5173
APP_ORDER_URL=http://localhost:5174

# Comma-separated additional CORS origins if needed
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# 3. Mercado Pago Credentials (Sandbox TEST-... or Production APP_USR-...)
# Note: When APP_BASE_URL starts with https:// (not localhost), Mercado Pago
# webhooks (/api/payments/mp/webhook) and auto_return are enabled automatically.
# ------------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX_ENABLED=true

# ------------------------------------------------------------------------------
# 4. Bank Transfer Details (TPI N°2)
# ------------------------------------------------------------------------------
PAYMENT_BANK_ALIAS=DULCE.MAYOR.MZA
PAYMENT_BANK_CBU=0000003100084920193842
PAYMENT_BANK_HOLDER=Dulce Mayor S.A.

# ------------------------------------------------------------------------------
# 5. SMTP Email Notifications
# ------------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_FROM=no-reply@dulcemayor.com.ar
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

# ------------------------------------------------------------------------------
# 6. Google Gemini AI & Auth0 Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AUTH0_DOMAIN=dev-is022ursig5yhq3k.us.auth0.com
AUTH0_CLIENT_ID=CfWfvGPNV2dHB72zT1yU6dFI0eMpaQZF
