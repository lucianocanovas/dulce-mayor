# ==============================================================================
# Dulce Mayor Server — Environment Variables Example
# Copy to .env (never commit real credentials to Git)
# ==============================================================================

# Mercado Pago Credentials (Sandbox TEST-... or Production APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX_ENABLED=true

# Public / Local URLs
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8081
APP_CENTRAL_URL=http://localhost:5173
APP_ORDER_URL=http://localhost:5174

# Bank Transfer Details
PAYMENT_BANK_ALIAS=DULCE.MAYOR.MZA
PAYMENT_BANK_CBU=0000003100084920193842
PAYMENT_BANK_HOLDER=Dulce Mayor S.A.

# Optional SMTP Mail Settings
MAIL_ENABLED=false
MAIL_FROM=no-reply@dulcemayor.com.ar
