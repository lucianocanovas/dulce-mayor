# ==============================================================================
# Dulce Mayor — Docker Compose Environment Variables Example (DonWeb VPS)
# Copy this file to .env in the project root before running: docker compose up -d --build
# ==============================================================================

# PostgreSQL
DB_NAME=dulcemayor
DB_USER=dulcemayor
DB_PASSWORD=dulcemayor_prod_secret
DB_EXTERNAL_PORT=5432
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Host Ports Exposed on the VPS
SERVER_PORT=8080
LANDING_PORT=8081
CENTRAL_PORT=5173
ORDER_PORT=5174

# Public URLs (Replace localhost with your DonWeb VPS IP or HTTPS domain)
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8081
APP_CENTRAL_URL=http://localhost:5173
APP_ORDER_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:5174

# Frontend API URL passed at build time (default /api uses Nginx reverse proxy to server:8080)
VITE_CENTRAL_API_URL=/api
VITE_ORDER_API_URL=/api

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX_ENABLED=true

# Bank Transfer
PAYMENT_BANK_ALIAS=DULCE.MAYOR.MZA
PAYMENT_BANK_CBU=0000003100084920193842
PAYMENT_BANK_HOLDER=Dulce Mayor S.A.

# SMTP Mail
MAIL_ENABLED=false
MAIL_FROM=no-reply@dulcemayor.com.ar
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# AI & Auth0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AUTH0_DOMAIN=dev-is022ursig5yhq3k.us.auth0.com
AUTH0_CLIENT_ID=CfWfvGPNV2dHB72zT1yU6dFI0eMpaQZF

